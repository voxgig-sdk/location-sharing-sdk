# Entity: export

main: kit: entity: export: {

  alias: field: {}

  name: "export"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/export/csv"
          segments: [
            {
              lit: "export"
            }
            {
              lit: "csv"
            }
          ]
          select: {
            "$action": "csv"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/export/geojson"
          segments: [
            {
              lit: "export"
            }
            {
              lit: "geojson"
            }
          ]
          select: {
            "$action": "geojson"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/export/kml"
          segments: [
            {
              lit: "export"
            }
            {
              lit: "kml"
            }
          ]
          select: {
            "$action": "kml"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
