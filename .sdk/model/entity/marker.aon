# Entity: marker

main: kit: entity: marker: {

  alias: field: {}

  fields: [
    {
      name: "address"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "createdAt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "Unique marker identifier"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "latitude"
      req: true
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "longitude"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      short: "Name or label for the marker"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "marker"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/markers"
          segments: [
            {
              lit: "markers"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/markers"
          segments: [
            {
              lit: "markers"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          method: "DELETE"
          orig: "/markers"
          segments: [
            {
              lit: "markers"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
